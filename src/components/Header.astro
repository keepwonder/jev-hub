---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/discussions', label: '讨论墙' },
  { href: '/tutorials', label: '教程' },
  { href: '/cookbooks', label: 'Cookbook' },
  { href: '/docs', label: '官方文档' },
  { href: '/articles', label: '文章归档' },
  { href: '/community', label: '社区项目' },
  { href: '/tools/cheatsheet', label: '速查' },
  { href: '/tools/confidence-calculator', label: '工具' },
  { href: '/compare', label: '对比' },
  { href: '/glossary', label: '术语' },
  { href: '/changelog', label: '更新' },
  { href: '/about', label: '关于' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b backdrop-blur" style="background-color: color-mix(in oklab, var(--color-bg) 80%, transparent); border-color: var(--color-border);">
  <div class="container-wide flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-signal-600 font-mono text-sm font-bold text-white">J</span>
      <span class="hidden sm:inline">Jev Hub</span>
    </a>
    <nav class="hidden flex-1 items-center gap-1 overflow-x-auto px-3 lg:flex" aria-label="主导航">
      {navItems.map(({ href, label }) => {
        const active = href === '/' ? path === '/' : path.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-sm transition whitespace-nowrap',
              active
                ? 'bg-signal-100 font-medium text-signal-800 dark:bg-signal-900/40 dark:text-signal-200'
                : 'text-ink-700 hover:bg-ink-100 dark:text-ink-200 dark:hover:bg-ink-800',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>
    <div class="flex items-center gap-2">
      <button id="cmd-k-trigger" class="btn-ghost hidden md:inline-flex" aria-label="搜索">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="text-sm">搜索</span>
        <kbd class="ml-2 rounded border border-ink-300 px-1.5 text-xs dark:border-ink-600">⌘K</kbd>
      </button>
      <button id="theme-toggle" class="btn-ghost" aria-label="切换主题">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark:hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:inline-block"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
      <a href="/rss.xml" class="btn-ghost hidden md:inline-flex" aria-label="RSS" title="RSS 订阅">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
      <button id="mobile-menu" class="btn-ghost lg:hidden" aria-label="菜单">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="container-wide hidden border-t pb-4 pt-2 lg:hidden" style="border-color: var(--color-border);">
    <div class="grid grid-cols-2 gap-1 sm:grid-cols-3">
      {navItems.map(({ href, label }) => (
        <a href={href} class="rounded-md px-2 py-1.5 text-sm text-ink-700 hover:bg-ink-100 dark:text-ink-200 dark:hover:bg-ink-800">{label}</a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  // theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
  // mobile menu
  const mm = document.getElementById('mobile-menu');
  const mn = document.getElementById('mobile-nav');
  mm?.addEventListener('click', () => mn?.classList.toggle('hidden'));
  // Cmd+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-search'));
    }
  });
  document.getElementById('cmd-k-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>
