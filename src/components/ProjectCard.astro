---
interface Props {
  p: {
    name: string;
    owner: string;
    description: string;
    url: string;
    stars: number;
    forks?: number;
    language: string | null;
    topics?: string[];
    tags: string[];
    createdAt: string;
    updatedAt: string;
    pushedAt?: string | null;
  };
  compact?: boolean;
}
const { p, compact = false } = Astro.props;
// Show time since last commit (pushedAt), not creation date.
const lastActivity = p.pushedAt ?? p.updatedAt ?? p.createdAt;
const ageDays = Math.floor((Date.now() - new Date(lastActivity).getTime()) / (24 * 3600 * 1000));
const activity =
  ageDays <= 7  ? { dot: 'bg-signal-500',  text: '本周活跃' }
: ageDays <= 30 ? { dot: 'bg-signal-500',  text: '本月活跃' }
: ageDays <= 90 ? { dot: 'bg-ink-400',     text: '本季度活跃' }
: ageDays <= 365? { dot: 'bg-ink-300',     text: `${Math.floor(ageDays / 30)} 月前活跃` }
:                { dot: 'bg-ink-300',     text: `${Math.floor(ageDays / 365)} 年前活跃` };

const ICON_STAR = '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>';
const ICON_FORK = '<circle cx="6" cy="3" r="2"/><circle cx="6" cy="21" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 5v14"/><path d="M18 8v3a4 4 0 0 1-4 4H6"/>';
---
<article
  class="card project-card flex flex-col gap-2.5"
  data-name={p.name.toLowerCase()}
  data-owner={p.owner.toLowerCase()}
  data-desc={(p.description || '').toLowerCase()}
  data-language={p.language ?? 'unknown'}
  data-stars={p.stars}
  data-forks={p.forks ?? 0}
  data-created={p.createdAt}
  data-updated={p.updatedAt}
  data-tags={(p.tags ?? []).join(',')}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class:list={[compact ? 'text-base' : 'text-lg', 'font-semibold leading-snug truncate']}>
        <a href={p.url} target="_blank" rel="noopener" class="hover:underline">{p.name}</a>
      </h3>
      <p class="font-mono text-[11px] text-ink-500 truncate">@{p.owner}</p>
    </div>
    <div class="flex flex-shrink-0 items-center gap-1.5">
      <span class="badge-ink gap-1 font-mono tabular-nums" title="GitHub stars">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_STAR}></svg>
        {p.stars.toLocaleString()}
      </span>
      {p.language && <span class="badge-ink">{p.language}</span>}
    </div>
  </div>
  <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-400 line-clamp-2">{p.description || '暂无描述'}</p>
  <div class="mt-auto flex flex-wrap items-center gap-1 pt-2 text-xs">
    {(p.tags ?? []).slice(0, 3).map((t) => <span class="badge-ink">{t}</span>)}
    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-ink-400 tabular-nums" title={`创建于 ${p.createdAt} · 最后提交 ${p.pushedAt ?? p.updatedAt}`}>
      <span class:list={['inline-block h-1.5 w-1.5 rounded-full', activity.dot]}></span>
      {activity.text}
    </span>
  </div>
</article>