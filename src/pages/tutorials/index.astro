---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || +a.data.pubDate - +b.data.pubDate);
---
<BaseLayout title="教程" description="Jev 从入门到实战的系列教程。">
  <Search />

  <section class="container-wide py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">入门教程</h1>
      <p class="mt-2 text-ink-600 dark:text-ink-400">从"它是什么"到"真的能跑起来"。读完前三篇就能独立接入。</p>
    </header>

    <ol class="space-y-4">
      {tutorials.map((t, i) => (
        <li>
          <a href={`/tutorials/${t.slug}`} class="card flex flex-col gap-3 sm:flex-row sm:items-start">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-signal-100 font-mono font-bold text-signal-700 dark:bg-signal-900/40 dark:text-signal-200">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 text-xs text-ink-500">
                <time datetime={t.data.pubDate.toISOString()}>{t.data.pubDate.toISOString().slice(0, 10)}</time>
                <span>·</span>
                <span>{t.data.author}</span>
              </div>
              <h2 class="mt-1 text-xl font-semibold">{t.data.title}</h2>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">{t.data.description}</p>
              <div class="mt-3 flex flex-wrap gap-1">
                {t.data.tags.map((tag) => <span class="badge-ink">{tag}</span>)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
