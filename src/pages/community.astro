---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
import data from '@/data/awesome-typesafe.json';

const projects = (data as any).projects ?? (data as any);  // tolerate old shape
const meta = (data as any).meta ?? { lastUpdated: null, okCount: projects.length };

// Format lastUpdated timestamp
let lastUpdatedLabel = '从未刷新';
let lastUpdatedRel = '';
if (meta.lastUpdated) {
  const d = new Date(meta.lastUpdated);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffH = Math.floor(diffMs / (1000 * 60 * 60));
  lastUpdatedLabel = d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
  if (diffH < 1) lastUpdatedRel = `${Math.max(1, Math.floor(diffMs / 60000))} 分钟前`;
  else if (diffH < 24) lastUpdatedRel = `${diffH} 小时前`;
  else lastUpdatedRel = `${Math.floor(diffH / 24)} 天前`;
}
---
<BaseLayout title="社区项目" description="awesome-typesafe:Jev 相关的开源项目和工具索引。">
  <Search />

  <section class="container-wide py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">社区项目</h1>
      <p class="mt-2 text-ink-600 dark:text-ink-400">
        基于 GitHub Search API 实时拉取的 Jev 相关项目。每 6 小时自动刷新一次。
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
        <span class="inline-flex items-center gap-2 rounded-full bg-calibrated-500/10 px-3 py-1 text-calibrated-600 dark:text-calibrated-400">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-calibrated-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-calibrated-500"></span>
          </span>
          数据已刷新
        </span>
        <span class="text-ink-500">
          共 <strong>{meta.okCount ?? projects.length}</strong> 个项目 · {lastUpdatedRel}
        </span>
        <span class="text-xs text-ink-400 font-mono" title={meta.lastUpdated}>
          {lastUpdatedLabel}
        </span>
      </div>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {projects.map((p: any) => {
        const isOk = p.status !== 'not-found' && p.stars != null;
        const cardCls = isOk
          ? 'card flex flex-col gap-2'
          : 'card flex flex-col gap-2 opacity-60';
        const starLabel = p.stars != null ? p.stars.toLocaleString() : 'N/A';
        return (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class={cardCls}
            data-status={p.status}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold">{p.name}</h3>
                <p class="text-xs text-ink-500">@{p.owner}</p>
              </div>
              <div class="flex flex-shrink-0 items-center gap-2">
                {isOk ? (
                  <span class="badge-amber" title="GitHub stars">⭐ {starLabel}</span>
                ) : (
                  <span class="badge-ink" title="GitHub API 暂未找到">N/A</span>
                )}
                {p.language && <span class="badge-ink">{p.language}</span>}
              </div>
            </div>
            <p class="text-sm text-ink-600 dark:text-ink-400 line-clamp-3">
              {p.description || '暂无描述'}
            </p>
            <div class="mt-auto flex flex-wrap items-center gap-1 pt-2">
              {(p.tags ?? []).slice(0, 4).map((t: string) => <span class="badge-ink">{t}</span>)}
              {p.updatedAt && (
                <span class="ml-auto text-xs text-ink-400" title={`GitHub 最后更新时间: ${p.updatedAt}`}>
                  上游更新于 {p.updatedAt}
                </span>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-10 rounded-lg border p-4 text-sm" style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 50%, transparent);">
      <h2 class="mb-2 font-semibold">数据来源</h2>
      <ul class="space-y-1 text-ink-600 dark:text-ink-400">
        <li>• 项目来自 <a class="link" href="https://api.github.com/search/repositories?q=typesafe+jev" target="_blank" rel="noopener">GitHub Search API</a>(每次拉取 100 个按星数排序的 jev 相关仓库)</li>
        <li>• 通过 <code class="text-xs">npm run fetch:github</code> 在 GitHub Actions 里每 6 小时跑一次(<a class="link" href="https://github.com/keepwonder/jev-hub/blob/main/.github/workflows/fetch-data.yml" target="_blank" rel="noopener">workflow</a>)</li>
        <li>• 想收录你的项目?在 <a class="link" href="/about">关于页</a> 找到 GitHub 仓库,提 PR 修改 <code class="text-xs">scripts/fetch-github.ts</code> 里的 <code class="text-xs">FEATURED</code> 白名单</li>
      </ul>
    </div>
  </section>
</BaseLayout>
