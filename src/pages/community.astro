---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import data from '@/data/awesome-typesafe.json';

const projects: any[] = (data as any).projects ?? [];
const meta = (data as any).meta ?? {};
const languages: { name: string; count: number }[] = meta.languages ?? [];

let lastUpdatedLabel = '从未刷新';
let lastUpdatedRel = '';
if (meta.lastUpdated) {
  const d = new Date(meta.lastUpdated);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffH = Math.floor(diffMs / (1000 * 60 * 60));
  // 本地时间 — 不用 toISOString()（永远 UTC），用 getXxx() 拿本地时区
  const pad = (n: number) => String(n).padStart(2, '0');
  lastUpdatedLabel = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  if (diffH < 1) lastUpdatedRel = `${Math.max(1, Math.floor(diffMs / 60000))} 分钟前`;
  else if (diffH < 24) lastUpdatedRel = `${diffH} 小时前`;
  else lastUpdatedRel = `${Math.floor(diffH / 24)} 天前`;
}
---
<BaseLayout title="社区项目" description="Jev 相关开源项目索引,自动从 GitHub 抓取,可按语言/时间/星数筛选。">
  <Search />

  <section class="container-wide py-10">
    <header class="mb-6">
      <h1 class="text-3xl font-bold">社区项目</h1>
      <p class="mt-2 text-ink-600 dark:text-ink-400">
        GitHub 上所有 Jev 相关开源项目。可按时间、语言、星数筛选。
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
        <span class="inline-flex items-center gap-2 rounded-full bg-calibrated-500/10 px-3 py-1 text-calibrated-700 dark:text-calibrated-400">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-calibrated-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-calibrated-500"></span>
          </span>
          数据已刷新
        </span>
        <span class="text-ink-500">
          显示 <strong id="visible-count">{projects.length}</strong> / {projects.length} 个项目 · {lastUpdatedRel}
        </span>
        <span class="text-xs text-ink-400 font-mono" title={meta.lastUpdated}>{lastUpdatedLabel}</span>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="card mb-6 space-y-4">
      <!-- Search box -->
      <div class="relative">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          id="filter-search"
          type="search"
          placeholder="搜索项目名 / 描述 / 作者…"
          class="w-full rounded-md border bg-transparent py-2 pl-9 pr-3 text-sm focus:border-signal-400 focus:outline-none"
          style="border-color: var(--color-border);"
        />
      </div>

      <!-- Sort + Time row -->
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase text-ink-500">排序</label>
          <select id="filter-sort" class="w-full rounded-md border bg-transparent px-3 py-1.5 text-sm" style="border-color: var(--color-border);">
            <option value="stars-desc">星数 (高→低)</option>
            <option value="stars-asc">星数 (低→高)</option>
            <option value="created-desc">最新创建</option>
            <option value="updated-desc">最近活跃</option>
            <option value="forks-desc">分叉数 (高→低)</option>
            <option value="name-asc">名字 A→Z</option>
          </select>
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase text-ink-500">创建时间</label>
          <div class="flex flex-wrap gap-1">
            {['all', '30d', '90d', '365d'].map((p, i) => (
              <button data-time={p} class:list={['time-pill flex-1 rounded-md border px-2 py-1 text-xs transition', i === 0 ? 'active' : '']} style="border-color: var(--color-border);">
                {p === 'all' ? '全部' : p === '30d' ? '30 天' : p === '90d' ? '90 天' : '1 年'}
              </button>
            ))}
          </div>
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase text-ink-500">最低星数</label>
          <div class="flex flex-wrap gap-1">
            {[0, 10, 50, 100, 500].map((n, i) => (
              <button data-min-stars={n} class:list={['stars-pill flex-1 rounded-md border px-2 py-1 text-xs transition', i === 0 ? 'active' : '']} style="border-color: var(--color-border);">
                {n === 0 ? '任意' : `${n}+`}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Language chips -->
      {languages.length > 0 && (
        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase text-ink-500">语言(点击多选)</label>
          <div class="flex flex-wrap gap-1.5" id="filter-langs">
            {languages.map((l) => (
              <button
                data-lang={l.name}
                class="lang-chip inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs transition"
                style="border-color: var(--color-border);"
              >
                <span>{l.name}</span>
                <span class="text-ink-400">{l.count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Reset + active filter count -->
      <div class="flex flex-wrap items-center gap-2 border-t pt-3 text-xs" style="border-color: var(--color-border);">
        <button id="filter-reset" class="rounded-md border px-3 py-1 transition hover:bg-ink-100 dark:hover:bg-ink-800" style="border-color: var(--color-border);">
          重置筛选
        </button>
        <span id="filter-summary" class="text-ink-500"></span>
      </div>
    </div>

    <!-- Project grid -->
    <div id="project-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <div class:list={['project-item', i >= 24 ? 'hidden-more' : '']}>
          <ProjectCard p={p} compact />
        </div>
      ))}
    </div>

    <!-- Show more -->
    <div class="mt-8 text-center">
      <button
        id="show-more-btn"
        class="rounded-md border px-6 py-2 text-sm transition hover:bg-ink-100 dark:hover:bg-ink-800"
        style="border-color: var(--color-border);"
      >
        显示更多 (<span id="hidden-count">0</span>)
      </button>
    </div>

    <p id="no-results" class="hidden py-12 text-center text-ink-500">
      没有匹配的项目。<button id="clear-filters" class="link">清除筛选条件</button>?
    </p>

    <div class="mt-10 rounded-lg border p-4 text-sm" style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 50%, transparent);">
      <h2 class="mb-2 font-semibold">数据来源与说明</h2>
      <ul class="space-y-1 text-ink-600 dark:text-ink-400">
        <li>• 来自 <a class="link" href="https://api.github.com/search/repositories?q=typesafe+jev+stars:%3E5" target="_blank" rel="noopener">GitHub Search API</a>,筛选条件:关键词 "typesafe jev" + ≥5 stars</li>
        <li>• 想找更多?<a class="link" href="https://github.com/search?q=typesafe+jev&type=repositories" target="_blank" rel="noopener">在 GitHub 上搜索</a></li>
      </ul>
    </div>
  </section>

  <style>
    /* Show-more: 默认隐藏 INITIAL_LIMIT 之后的卡片 */
    .project-item.hidden-more {
      display: none;
    }
  </style>
</BaseLayout>

<script>
  type Card = HTMLElement & { dataset: DOMStringMap };
  const grid = document.getElementById('project-grid')!;
  const noResults = document.getElementById('no-results')!;
  const visibleCount = document.getElementById('visible-count')!;
  const summary = document.getElementById('filter-summary')!;
  const cards: Card[] = Array.from(grid.querySelectorAll<HTMLElement>('.project-card')) as Card[];
  const INITIAL_LIMIT = 24;
  const showMoreBtn = document.getElementById('show-more-btn')!;
  const hiddenCountEl = document.getElementById('hidden-count')!;
  let showingAll = false;

  // State
  const state = {
    q: '',
    sort: 'stars-desc',
    time: 'all',
    minStars: 0,
    langs: new Set<string>(),
  };

  function activePillButtons() {
    document.querySelectorAll<HTMLButtonElement>('.time-pill').forEach((b) => {
      const active = b.dataset.time === state.time;
      b.classList.toggle('active', active);
      b.style.backgroundColor = active ? 'var(--color-accent)' : '';
      b.style.color = active ? 'white' : '';
      b.style.borderColor = active ? 'var(--color-accent)' : '';
    });
    document.querySelectorAll<HTMLButtonElement>('.stars-pill').forEach((b) => {
      const active = parseInt(b.dataset.minStars || '0', 10) === state.minStars;
      b.classList.toggle('active', active);
      b.style.backgroundColor = active ? 'var(--color-accent)' : '';
      b.style.color = active ? 'white' : '';
      b.style.borderColor = active ? 'var(--color-accent)' : '';
    });
  }

  function passes(card: Card): boolean {
    const data = card.dataset;

    // search
    if (state.q) {
      const blob = `${data.name} ${data.owner} ${data.desc} ${data.tags}`;
      if (!blob.includes(state.q)) return false;
    }

    // time
    if (state.time !== 'all') {
      const days = parseInt(state.time, 10);
      const created = new Date(data.created || '1970-01-01').getTime();
      if (Date.now() - created > days * 24 * 3600 * 1000) return false;
    }

    // min stars
    if (state.minStars > 0) {
      if (parseInt(data.stars || '0', 10) < state.minStars) return false;
    }

    // language
    if (state.langs.size > 0 && !state.langs.has(data.language || 'unknown')) return false;

    return true;
  }

  function sortCards(): void {
    const sorted = [...cards].sort((a, b) => {
      const da = a.dataset;
      const db = b.dataset;
      const starsA = parseInt(da.stars || '0', 10);
      const starsB = parseInt(db.stars || '0', 10);
      const forksA = parseInt(da.forks || '0', 10);
      const forksB = parseInt(db.forks || '0', 10);
      const createdA = da.created || '';
      const createdB = db.created || '';
      const updatedA = da.updated || '';
      const updatedB = db.updated || '';
      const nameA = da.name || '';
      const nameB = db.name || '';
      switch (state.sort) {
        case 'stars-asc': return starsA - starsB;
        case 'created-desc': return createdB.localeCompare(createdA);
        case 'updated-desc': return updatedB.localeCompare(updatedA);
        case 'forks-desc': return forksB - forksA;
        case 'name-asc': return nameA.localeCompare(nameB);
        case 'stars-desc':
        default: return starsB - starsA;
      }
    });
    for (const card of sorted) grid.appendChild(card);
  }

  function updateShowMore() {
    if (showingAll) {
      showMoreBtn.style.display = 'none';
      return;
    }
    const hasActiveFilter = state.q || state.time !== 'all' || state.minStars > 0 || state.langs.size > 0;
    const hiddenCount = document.querySelectorAll<HTMLElement>('.project-item.hidden-more').length;
    const visibleNow = Array.from(cards).filter(c => c.style.display !== 'none').length;

    // Always show button if hidden cards exist OR filter is active.
    // (Old behavior: hide when visibleNow <= INITIAL_LIMIT, which made the
    // button invisible when filters reduce count to 5 — users had no way
    // to "expand".)
    if (hiddenCount > 0 || hasActiveFilter) {
      showMoreBtn.style.display = '';
      if (hasActiveFilter) {
        hiddenCountEl.textContent = `清除筛选 · 查看全部 (${cards.length})`;
      } else {
        hiddenCountEl.textContent = String(hiddenCount);
      }
    } else {
      showMoreBtn.style.display = 'none';
    }
  }

  function apply() {
    sortCards();
    let visible = 0;
    for (const card of cards) {
      const ok = passes(card);
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    }
    visibleCount.textContent = String(visible);
    noResults.classList.toggle('hidden', visible > 0);
    grid.classList.toggle('hidden', visible === 0);

    // Reset all wrappers' hidden-more state, then re-apply based on
    // VISIBLE ORDER (not DOM index). The old version used `grid.children`
    // index, which broke when sorting changed and when filters hid cards
    // interleaved with visible ones.
    Array.from(grid.children).forEach((w) => {
      if (w instanceof HTMLElement) w.classList.remove('hidden-more');
    });

    if (!showingAll) {
      let count = 0;
      Array.from(grid.children).forEach((w) => {
        if (!(w instanceof HTMLElement)) return;
        const card = w.querySelector('.project-card') as HTMLElement;
        if (!card || card.style.display === 'none') return;
        count++;
        if (count > INITIAL_LIMIT) {
          w.classList.add('hidden-more');
        }
      });
    }

    updateShowMore();

    // active filter summary
    const parts: string[] = [];
    if (state.q) parts.push(`"${state.q}"`);
    if (state.time !== 'all') parts.push(`${state.time} 内`);
    if (state.minStars > 0) parts.push(`≥${state.minStars} 星`);
    if (state.langs.size > 0) parts.push(`语言: ${[...state.langs].join(', ')}`);
    summary.textContent = parts.length ? `已应用: ${parts.join(' · ')}` : '';
  }

  showMoreBtn.addEventListener('click', () => {
    showingAll = true;
    // Also clear all filters so users actually see the full list.
    // Without this, clicking "show more" with ≥500★ filter would still
    // show only 5 cards — the user's exact complaint.
    state.q = '';
    state.time = 'all';
    state.minStars = 0;
    state.langs.clear();
    state.sort = 'stars-desc';
    (document.getElementById('filter-search') as HTMLInputElement).value = '';
    (document.getElementById('filter-sort') as HTMLSelectElement).value = 'stars-desc';
    document.querySelectorAll<HTMLButtonElement>('.lang-chip').forEach((b) => {
      b.style.backgroundColor = '';
      b.style.color = '';
      b.style.borderColor = '';
    });
    activePillButtons();
    document.querySelectorAll<HTMLElement>('.project-item.hidden-more').forEach((el) => {
      el.classList.remove('hidden-more');
    });
    apply();
  });

  // Wire up listeners
  document.getElementById('filter-search')?.addEventListener('input', (e) => {
    state.q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    apply();
  });
  document.getElementById('filter-sort')?.addEventListener('change', (e) => {
    state.sort = (e.target as HTMLSelectElement).value;
    apply();
  });
  document.querySelectorAll<HTMLButtonElement>('.time-pill').forEach((b) => {
    b.addEventListener('click', () => {
      state.time = b.dataset.time || 'all';
      activePillButtons();
      apply();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.stars-pill').forEach((b) => {
    b.addEventListener('click', () => {
      state.minStars = parseInt(b.dataset.minStars || '0', 10);
      activePillButtons();
      apply();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.lang-chip').forEach((b) => {
    b.addEventListener('click', () => {
      const lang = b.dataset.lang || '';
      if (state.langs.has(lang)) state.langs.delete(lang);
      else state.langs.add(lang);
      b.style.backgroundColor = state.langs.has(lang) ? 'var(--color-accent)' : '';
      b.style.color = state.langs.has(lang) ? 'white' : '';
      b.style.borderColor = state.langs.has(lang) ? 'var(--color-accent)' : '';
      apply();
    });
  });

  function reset() {
    state.q = '';
    state.sort = 'stars-desc';
    state.time = 'all';
    state.minStars = 0;
    state.langs.clear();
    (document.getElementById('filter-search') as HTMLInputElement).value = '';
    (document.getElementById('filter-sort') as HTMLSelectElement).value = 'stars-desc';
    document.querySelectorAll<HTMLButtonElement>('.lang-chip').forEach((b) => {
      b.style.backgroundColor = '';
      b.style.color = '';
      b.style.borderColor = '';
    });
    activePillButtons();
    apply();
  }
  document.getElementById('filter-reset')?.addEventListener('click', reset);
  document.getElementById('clear-filters')?.addEventListener('click', reset);

  activePillButtons();
  apply();
</script>
