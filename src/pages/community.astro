---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import data from '@/data/awesome-typesafe.json';

const projects: any[] = (data as any).projects ?? [];
const trending: any[] = (data as any).trending ?? [];
const meta = (data as any).meta ?? {};

let lastUpdatedLabel = '从未刷新';
let lastUpdatedRel = '';
if (meta.lastUpdated) {
  const d = new Date(meta.lastUpdated);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffH = Math.floor(diffMs / (1000 * 60 * 60));
  lastUpdatedLabel = d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
  if (diffH < 1) lastUpdatedRel = `${Math.max(1, Math.floor(diffMs / 60000))} 分钟前`;
  else if (diffH < 24) lastUpdatedRel = `${diffH} 小时前`;
  else lastUpdatedRel = `${Math.floor(diffH / 24)} 天前`;
}
---
<BaseLayout title="社区项目" description="awesome-typesafe:Jev 相关的开源项目和工具索引。">
  <Search />

  <section class="container-wide py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">社区项目</h1>
      <p class="mt-2 text-ink-600 dark:text-ink-400">
        精选 {projects.length} 个高质量项目 + 自动发现近期活跃的 {trending.length} 个新项目。每 6 小时自动刷新一次。
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
        <span class="inline-flex items-center gap-2 rounded-full bg-calibrated-500/10 px-3 py-1 text-calibrated-700 dark:text-calibrated-400">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-calibrated-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-calibrated-500"></span>
          </span>
          数据已刷新
        </span>
        <span class="text-ink-500">
          {meta.okCount ?? projects.length} 精选 + {trending.length} 新发现 · {lastUpdatedRel}
        </span>
        <span class="text-xs text-ink-400 font-mono" title={meta.lastUpdated}>{lastUpdatedLabel}</span>
      </div>
    </header>

    <!-- Featured -->
    <section class="mb-12">
      <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="text-caution-500"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        精选项目
        <span class="text-sm font-normal text-ink-500">— 人工白名单,质量优先</span>
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {projects.map((p) => <ProjectCard p={p} />)}
      </div>
    </section>

    <!-- Trending -->
    {trending.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-signal-500"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          近期发现
          <span class="text-sm font-normal text-ink-500">— 最近 60 天创建、≥10★ 的 jev 相关项目(自动)</span>
        </h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {trending.map((p) => <ProjectCard p={p} compact />)}
        </div>
        <p class="mt-4 text-sm text-ink-500">
          想被收录到精选列表?在 <a class="link" href="https://github.com/keepwonder/jev-hub/issues/new" target="_blank" rel="noopener">GitHub 提个 issue</a>,项目描述里说明用途即可。
        </p>
      </section>
    )}

    <div class="rounded-lg border p-4 text-sm" style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 50%, transparent);">
      <h2 class="mb-2 font-semibold">数据来源与提交流程</h2>
      <ul class="space-y-1 text-ink-600 dark:text-ink-400">
        <li>• 项目来自 <a class="link" href="https://api.github.com/search/repositories?q=typesafe+jev" target="_blank" rel="noopener">GitHub Search API</a>(每次拉取 100 个 jev 相关仓库)</li>
        <li>• <strong>精选列表</strong>:PR 修改 <code class="text-xs">scripts/fetch-github.ts</code> 里的 <code class="text-xs">FEATURED</code> 白名单(质量优先,需评审)</li>
        <li>• <strong>近期发现</strong>:全自动 — 最近 60 天创建、≥10★ 的 jev 项目,按星数排前 12</li>
        <li>• 每 6 小时跑一次 <code class="text-xs">npm run fetch:github</code>(<a class="link" href="https://github.com/keepwonder/jev-hub/blob/main/.github/workflows/fetch-data.yml" target="_blank" rel="noopener">workflow</a>)</li>
      </ul>
    </div>
  </section>
</BaseLayout>
