---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
import awesomeProjects from '@/data/awesome-typesafe.json';
---
<BaseLayout title="社区项目" description="awesome-typesafe:Jev 相关的开源项目和工具索引。">
  <Search />

  <section class="container-wide py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">社区项目</h1>
      <p class="mt-2 text-ink-600 dark:text-ink-400">
        基于 <a class="link" href="https://github.com/typesafe-ai/awesome" target="_blank" rel="noopener">awesome-typesafe</a>(社区维护)的项目索引。
        想收录你的项目?<a class="link" href="/about">联系我们</a>。
      </p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {(awesomeProjects as any[]).map((p) => (
        <a href={p.url} target="_blank" rel="noopener" class="card flex flex-col gap-2">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold">{p.name}</h3>
              <p class="text-xs text-ink-500">@{p.owner}</p>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2">
              <span class="badge-amber">⭐ {typeof p.stars === 'number' ? p.stars.toLocaleString() : p.stars}</span>
              {p.language && <span class="badge-ink">{p.language}</span>}
            </div>
          </div>
          <p class="text-sm text-ink-600 dark:text-ink-400 line-clamp-3">{p.description}</p>
          <div class="mt-auto flex flex-wrap items-center gap-1 pt-2">
            {(p.tags ?? []).slice(0, 4).map((t: string) => <span class="badge-ink">{t}</span>)}
            {p.updatedAt && <span class="ml-auto text-xs text-ink-400">更新于 {p.updatedAt}</span>}
          </div>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink-500">
      数据由 <a class="link" href="https://github.com" target="_blank" rel="noopener">GitHub Search API</a> 拉取,通过 <code>npm run fetch:github</code> 自动刷新(也可在 CI 每 6 小时跑)。
      想收录你的项目?在 <a class="link" href="/about">关于页</a> 找到 GitHub 仓库,提 PR 到 awesome-typesafe 白名单即可。
    </p>
  </section>
</BaseLayout>
