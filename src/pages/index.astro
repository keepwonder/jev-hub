---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TweetCard from '@/components/TweetCard.astro';
import Search from '@/components/Search.astro';
import { getCollection } from 'astro:content';

import tweetsData from '@/data/official-tweets.json';
import founderTweets from '@/data/founder-tweets.json';
import recentDiscussions from '@/data/recent-discussions.json';
import awesomeProjects from '@/data/awesome-typesafe.json';

const officialTweets = (tweetsData as any[]).slice(0, 3);
const discussions = (recentDiscussions as any[]).slice(0, 6);

const latestTutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 4);

// Real content counts (not .slice'd lengths)
const totalTweets =
  (tweetsData as any[]).length +
  (founderTweets as any[]).length +
  (recentDiscussions as any[]).length;
const allCookbooks = await getCollection('cookbooks');
const allTutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const allDocs = await getCollection('docs');
const allFaqs = await getCollection('faqs');
const allGlossary = await getCollection('glossary');
const allVersions = await getCollection('versions');
const projectCount = (awesomeProjects as any).projects?.length ?? (awesomeProjects as any[]).length;

const stats = {
  tweets: totalTweets,
  cookbooks: allCookbooks.length,
  tutorials: allTutorials.length,
  docs: allDocs.length,
  faqs: allFaqs.length,
  glossary: allGlossary.length,
  projects: projectCount,
  versions: allVersions.length,
};

const lastUpdated = new Date().toISOString().slice(0, 10);
---
<BaseLayout title="Jev Hub" description="Jev / TypeSafe AI 中文跟踪与文档聚合站:官方动态、X 讨论、Cookbook 实战、SDK 版本、横向对比。">
  <Search />

  <!-- HERO -->
  <section class="border-b" style="border-color: var(--color-border);">
    <div class="container-wide py-16 sm:py-24">
      <div class="grid items-center gap-8 lg:grid-cols-2">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-signal-200 bg-signal-50 px-3 py-1 text-xs font-medium text-signal-700 dark:border-signal-800 dark:bg-signal-900/30 dark:text-signal-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-signal-500"></span>
            </span>
            跟踪 TypeSafe AI 发布的 System One Model
          </div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
            <span class="bg-gradient-to-r from-signal-600 to-calibrated-500 bg-clip-text text-transparent">Jev</span> Hub
          </h1>
          <p class="mt-4 max-w-xl text-lg text-ink-600 dark:text-ink-300">
            一个不写文章、只做判断、跑得快到 70ms、便宜到输出免费的 AI。
            中文圈的跟踪站,聚合官方动态、X 讨论、实战 Cookbook、SDK 版本、横向对比。
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/tutorials" class="btn-primary">从入门到能用 →</a>
            <a href="/cookbooks" class="btn-ghost">看 Cookbook</a>
            <a href="/discussions" class="btn-ghost">最新讨论</a>
          </div>
          <dl class="mt-10 grid grid-cols-3 gap-4 text-sm">
            <div>
              <dt class="text-ink-500">社区讨论</dt>
              <dd class="mt-1 text-2xl font-semibold">{stats.tweets}</dd>
            </div>
            <div>
              <dt class="text-ink-500">Cookbook</dt>
              <dd class="mt-1 text-2xl font-semibold">{stats.cookbooks}</dd>
            </div>
            <div>
              <dt class="text-ink-500">教程</dt>
              <dd class="mt-1 text-2xl font-semibold">{stats.tutorials}</dd>
            </div>
          </dl>
          <dl class="mt-3 grid grid-cols-3 gap-4 text-xs text-ink-500">
            <div><span>{stats.docs} 文档</span></div>
            <div><span>{stats.faqs} FAQ</span></div>
            <div><span>{stats.glossary} 术语</span></div>
          </dl>
        </div>
        <div class="card relative overflow-hidden">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs text-ink-500">Python SDK 示例</span>
            <span class="badge-ink">demo · Jev Playground</span>
          </div>
          <pre class="font-mono text-xs leading-relaxed text-ink-700 dark:text-ink-200"><code>{`from typesafe_sdk import Choice, Noul, TypeSafeClient

client = TypeSafeClient()

resp = client.system_one(
    state="I was charged twice for order A-104. Please refund.",
    questions={
        "refund":  Noul("Customer requests refund?"),
        "team":    Choice(
            ["billing","technical","account","shipping"],
            instructions="Which team handles this?",
        ),
    },
)

if resp.refund.noul > 0.8 and resp.team.confidence > 0.85:
    route_to(resp.team.choice)
`}</code></pre>
          <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
            <div class="rounded-lg border border-calibrated-500/30 bg-calibrated-500/5 p-3">
              <div class="font-mono">refund.noul</div>
              <div class="mt-1 text-xl font-semibold text-calibrated-600 dark:text-calibrated-400">0.97</div>
            </div>
            <div class="rounded-lg border border-signal-500/30 bg-signal-500/5 p-3">
              <div class="font-mono">team.choice</div>
              <div class="mt-1 text-xl font-semibold text-signal-600 dark:text-signal-400">billing (0.95)</div>
            </div>
          </div>
          <p class="mt-3 text-xs text-ink-500">一次调用 · 2 个并行判断 · ~120ms · ≈ $0.00005</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 官方动态 -->
  <section class="container-wide py-12 sm:py-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="text-2xl font-bold">官方动态</h2>
      <a href="/discussions" class="text-sm link">查看全部 →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {officialTweets.map((t: any) => <TweetCard tweet={{ ...t, source: t.source ?? 'official' }} />)}
    </div>
  </section>

  <!-- 最新讨论 -->
  <section class="container-wide pb-12 sm:pb-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="text-2xl font-bold">社区热议</h2>
      <a href="/discussions" class="text-sm link">查看全部 →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {discussions.map((t: any) => <TweetCard tweet={{ ...t, source: t.source ?? 'community' }} />)}
    </div>
  </section>

  <!-- 教程入口 -->
  <section class="border-y py-12 sm:py-16" style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 50%, transparent);">
    <div class="container-wide">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="text-2xl font-bold">入门教程</h2>
        <a href="/tutorials" class="text-sm link">所有教程 →</a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {latestTutorials.map((t) => (
          <a href={`/tutorials/${t.slug}`} class="card flex h-full flex-col">
            <div class="mb-2 text-xs text-ink-500">{t.data.pubDate.toISOString().slice(0, 10)}</div>
            <h3 class="text-base font-semibold">{t.data.title}</h3>
            <p class="mt-2 line-clamp-3 flex-1 text-sm text-ink-600 dark:text-ink-400">{t.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-1">
              {t.data.tags.slice(0, 3).map((tag) => <span class="badge-ink">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide py-16">
    <div class="card flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <h3 class="text-xl font-semibold">想第一时间收到更新?</h3>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">
          订阅 RSS,或者关注 <a class="link" href="https://x.com/typesafeai" target="_blank" rel="noopener">@typesafeai</a>。
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/rss.xml" class="btn-primary">订阅 RSS</a>
        <a href="https://typesafe.ai" target="_blank" rel="noopener" class="btn-ghost">访问 typesafe.ai ↗</a>
      </div>
    </div>
  </section>

  <p class="container-wide pb-10 text-center text-xs text-ink-400">
    最后抓取: {lastUpdated} · 数据每 6–12 小时更新 · 本站非官方
  </p>
</BaseLayout>
